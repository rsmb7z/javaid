<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- OneStatementPerLine with try resources counted and FallThrough with the last group checked. -->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="warning"/>
  <property name="fileExtensions" value="java"/>
  <module name="TreeWalker">
    <module name="OneStatementPerLine"><property name="treatTryResourcesAsStatement" value="true"/></module><module name="FallThrough"><property name="checkLastCaseGroup" value="true"/></module>
  </module>
</module>
