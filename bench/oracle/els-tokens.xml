<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="warning"/>
  <property name="fileExtensions" value="java"/>
  <module name="TreeWalker">
    <module name="EmptyLineSeparator"><property name="tokens" value="VARIABLE_DEF, METHOD_DEF, ENUM_CONSTANT_DEF"/><property name="allowMultipleEmptyLines" value="false"/><property name="allowMultipleEmptyLinesInsideClassMembers" value="false"/></module>
  </module>
</module>
