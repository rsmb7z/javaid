<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="warning"/>
  <property name="fileExtensions" value="java"/>
  <module name="TreeWalker">
    <module name="IllegalTokenText"><property name="tokens" value="NUM_DOUBLE,NUM_FLOAT,NUM_INT,NUM_LONG,IDENT,COMMENT_CONTENT,STRING_LITERAL,CHAR_LITERAL,TEXT_BLOCK_CONTENT"/><property name="format" value="a{2}|bb|1_|\s$"/></module>
  </module>
</module>
