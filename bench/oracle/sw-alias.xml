<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
  <property name="severity" value="warning"/>
  <module name="SuppressWarningsFilter"/>
  <module name="LineLength"><property name="max" value="100"/></module>
  <module name="TreeWalker">
    <module name="SuppressWarningsHolder"><property name="aliasList" value="com.puppycrawl.tools.checkstyle.checks.coding.MagicNumberCheck=tag,MethodName=mn"/></module>
    <module name="MagicNumber"><property name="id" value="myid"/></module>
    <module name="MemberName"/>
    <module name="MethodName"/>
    <module name="FinalParameters"/>
    <module name="UnusedImports"/>
    <module name="AvoidStarImport"/>
  </module>
</module>
