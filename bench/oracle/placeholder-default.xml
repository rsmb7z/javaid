<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- How a property default behaves when the placeholder is unset. Probe7.java.
     MethodName: the whole value is a placeholder.
     ParameterName: the placeholder is only part of the value.
     MemberName: no placeholder at all, so the default must be ignored. -->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="warning"/>
  <property name="fileExtensions" value="java"/>
  <module name="TreeWalker">
    <module name="MethodName">
      <property name="format" value="${javaid.probe.unset}" default="^[A-Z]+$"/>
    </module>
    <module name="ParameterName">
      <property name="format" value="^[a-z]+${javaid.probe.unset}$" default="^[A-Z]+$"/>
    </module>
    <module name="MemberName">
      <property name="format" value="^[A-Z]+$" default="^[a-z]+$"/>
    </module>
  </module>
</module>
