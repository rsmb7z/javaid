<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="warning"/>
  <property name="fileExtensions" value="java"/>
  <module name="TreeWalker">
    <module name="LeftCurly"><property name="id" value="LcEolDefault"/></module>
    <module name="LeftCurly"><property name="id" value="LcNlDefault"/><property name="option" value="nl"/></module>
    <module name="LeftCurly"><property name="id" value="LcEolNoIgnore"/><property name="ignoreEnums" value="false"/></module>
    <module name="LeftCurly"><property name="id" value="LcNlow"/><property name="option" value="nlow"/></module>
    <module name="LeftCurly"><property name="id" value="LcNlSingle"/><property name="option" value="nl_or_singleline"/></module>
    <module name="LeftCurly">
      <property name="id" value="LcGoogleEol"/>
      <property name="tokens" value="ANNOTATION_DEF, CLASS_DEF, CTOR_DEF, ENUM_CONSTANT_DEF, ENUM_DEF, INTERFACE_DEF, LAMBDA, LITERAL_CATCH, LITERAL_DO, LITERAL_ELSE, LITERAL_FINALLY, LITERAL_FOR, LITERAL_IF, LITERAL_SWITCH, LITERAL_SYNCHRONIZED, LITERAL_TRY, LITERAL_WHILE, METHOD_DEF, OBJBLOCK, STATIC_INIT, RECORD_DEF, COMPACT_CTOR_DEF, SWITCH_RULE"/>
    </module>
    <module name="LeftCurly">
      <property name="id" value="LcGoogleNl"/>
      <property name="option" value="nl"/>
      <property name="tokens" value="LITERAL_CASE, LITERAL_DEFAULT"/>
    </module>
  </module>
</module>
