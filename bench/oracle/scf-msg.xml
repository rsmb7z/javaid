<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="warning"/>
  <property name="fileExtensions" value="java"/>
  <module name="FileTabCharacter"><property name="eachLine" value="true"/></module>
  <module name="LineLength"><property name="max" value="50"/></module>
  <module name="TreeWalker">
    <module name="UpperEll"/>
    <module name="EmptyStatement"/>
    <module name="MethodName"/>
    <module name="LocalVariableName"/>
    <module name="WhitespaceAround"/>
    <module name="TodoComment"><property name="format" value="TODO"/></module>
    <module name="ConstantName"><property name="id" value="constName"/></module>
    <module name="SuppressionCommentFilter"><property name="offCommentFormat" value="OFF (\w+)"/><property name="onCommentFormat" value="ON (\w+)"/><property name="checkFormat" value="$1"/><property name="messageFormat" value="[Tt]railing|Name"/></module>
  </module>
</module>
