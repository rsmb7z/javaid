<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- RegexpSingleline requiring 99 matches, with a custom message. -->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="warning"/>
  <property name="fileExtensions" value="java"/>
  <module name="RegexpSingleline"><property name="format" value="\s+$"/><property name="minimum" value="99"/><property name="maximum" value="100"/><property name="message" value="need more trailing whitespace"/></module>
</module>
