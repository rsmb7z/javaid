<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="warning"/>
  <property name="fileExtensions" value="java"/>
  <module name="TreeWalker">
    <module name="JavadocVariable"><property name="accessModifiers" value="public, protected, package, private"/></module>
    <module name="MethodLength"><property name="max" value="0"/><property name="countEmpty" value="true"/></module>
    <module name="DesignForExtension"/>
    <module name="MultipleVariableDeclarations"/>
    <module name="OneStatementPerLine"><property name="treatTryResourcesAsStatement" value="true"/></module>
    <module name="FinalParameters"/>
    <module name="HiddenField"/>
    <module name="InnerAssignment"/>
    <module name="DeclarationOrder"/>
    <module name="VisibilityModifier"/>
  </module>
</module>
