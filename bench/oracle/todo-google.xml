<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- Both TodoComment instances from google_checks.xml: a lookahead and a backreference. -->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="warning"/>
  <property name="fileExtensions" value="java"/>
  <module name="TreeWalker">
    <module name="TodoComment"><property name="id" value="TodoFormat"/><property name="format" value="^[ \t]*(?!TODO:)(?i:TODO)\b:?"/><message key="todo.match" value="&apos;&apos;TODO:&apos;&apos; must be written in all caps and followed by a colon."/></module>
    <module name="TodoComment"><property name="id" value="BoxComments"/><property name="format" value="^[ \t]*([*=#])\1{8,}[ \t]*$"/><message key="todo.match" value="Comment uses box-like repetitive character pattern."/></module>
  </module>
</module>
