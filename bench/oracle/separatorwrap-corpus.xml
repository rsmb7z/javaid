<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="warning"/>
  <property name="fileExtensions" value="java"/>
  <module name="TreeWalker">
    <module name="SeparatorWrap"><property name="id" value="SwEolDefault"/></module>
    <module name="SeparatorWrap"><property name="id" value="SwNlDefault"/><property name="option" value="nl"/></module>
    <module name="SeparatorWrap"><property name="id" value="SwEolAll"/><property name="tokens" value="DOT, COMMA, SEMI, ELLIPSIS, ARRAY_DECLARATOR, RBRACK, METHOD_REF"/></module>
    <module name="SeparatorWrap"><property name="id" value="SwNlAll"/><property name="option" value="NL"/><property name="tokens" value="DOT, COMMA, SEMI, ELLIPSIS, ARRAY_DECLARATOR, RBRACK, METHOD_REF"/></module>
    <module name="SeparatorWrap"><property name="id" value="SwEolParens"/><property name="tokens" value="LPAREN, RPAREN"/></module>
    <module name="SeparatorWrap"><property name="id" value="SwNlParens"/><property name="option" value="nl"/><property name="tokens" value="LPAREN, RPAREN"/></module>
  </module>
</module>
