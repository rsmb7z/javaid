<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
  <property name="charset" value="UTF-8"/><property name="tabWidth" value="4"/>
  <property name="severity" value="warning"/>
  <property name="fileExtensions" value="java"/>
  <module name="FileTabCharacter"><property name="eachLine" value="true"/></module>
  <module name="LineLength"><property name="max" value="30"/></module>
  <module name="TreeWalker">
    <module name="MemberName"/>
    <module name="NoWhitespaceBefore"/>
    <module name="NoWhitespaceAfter"><property name="tokens" value="ARRAY_INIT, INDEX_OP"/></module>
    <module name="RightCurly"><property name="option" value="alone"/></module>
    <module name="LeftCurly"><property name="option" value="nl"/></module>
    <module name="OneStatementPerLine"/>
    <module name="JavadocVariable"><property name="accessModifiers" value="public, protected, package, private"/></module>
  </module>
</module>
