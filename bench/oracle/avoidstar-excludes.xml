<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- AvoidStarImport with excludes: spaces trimmed, a trailing .* accepted, a class name excludes its static star import. -->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="warning"/>
  <property name="fileExtensions" value="java"/>
  <module name="TreeWalker">
    <module name="AvoidStarImport"><property name="excludes" value=" java.io.* , java.nio.file , java.lang.Math "/></module>
  </module>
</module>
